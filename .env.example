# Скопируйте этот файл в .env и заполните реальными значениями.
# .env в .gitignore — реальные секреты никогда не попадают в git.

# Токен Telegram-бота (@BotFather)
BOT_TOKEN=your_bot_token_here

# Ключ NASA API (https://api.nasa.gov/)
NASA_API_KEY=your_nasa_api_key_here

# Строка подключения к PostgreSQL (SQLAlchemy async, драйвер asyncpg)
DB_URL=postgresql+asyncpg://user:pass@host:port/db

# ID чата-администратора, через который кешируются медиа перед отправкой пользователям
ADMIN_CHAT_ID=your_admin_chat_id_here

# Нижняя граница даты APOD — не секрет, реальное значение: первый выпуск APOD
APOD_LOWER_BOUND=1995-06-16

# Публичные эндпоинты NASA API — не секреты
NASA_APOD_URL=https://api.nasa.gov/planetary/apod
NASA_EPIC_URL=https://api.nasa.gov/EPIC/api/natural
